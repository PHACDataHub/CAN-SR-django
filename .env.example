# Safe local Docker Compose defaults. Copy this file to .env and change values
# as needed. Never commit .env or real credentials.

# Django
SECRET_KEY=local-development-only-change-me
DEBUG=True
ENABLE_DEBUG_TOOLBAR=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
INTERNAL_IPS=127.0.0.1
IS_LOCAL_DEV=True

# PostgreSQL (used by the Django and PostgreSQL containers)
POSTGRES_DB=hail_django_db
POSTGRES_USER=hail_django_db_user
POSTGRES_PASSWORD=local-development-only-change-me
TEST_DB_NAME=hail_django_db_test

# Use the database-backed task worker in Compose. Set this to 1 only when
# intentionally running tasks synchronously in the web process.
USE_IMMEDIATE_TASKS=0

# Dummy/local integrations need no external credentials.
LLM_MODE=local
GROBID_URL=dev

# To use the optional Compose GROBID service, set:
# GROBID_URL=http://grobid:8070/

# Optional Azure OpenAI configuration
# LLM_MODE=azure
# AZURE_OPENAI_MODE=key
# AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com
# AZURE_OPENAI_API_KEY=

# Optional Azure Document Intelligence configuration
# FIGURE_EXTRACTION_MODE=azure
# AZURE_DOC_INT_MODE=key
# AZURE_DOC_INT_ENDPOINT=https://example.cognitiveservices.azure.com
# AZURE_DOC_INT_API_KEY=